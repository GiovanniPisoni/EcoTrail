# Port on which the Express server is running
PORT=3000

# Client origin, used by the CORS configuration
CLIENT_ORIGIN=http://localhost:5173

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/EcoTrail

# Secret for signing JWT tokens
JWT_SECRET=your_jwt_secret_key

# VAPID key pair for Web Push 
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@ecotrail.test

# Directory where report photos are stored. Optional: defaults to server/uploads
# UPLOADS_DIR=

# Google Gemini API key (https://aistudio.google.com), used to suggest alternative trails.
# Optional: without it the app falls back to the closest free trail.
# GEMINI_API_KEY=your_gemini_api_key
# Optional: Gemini model, defaults to gemini-3.5-flash-lite
# AI_MODEL=gemini-3.5-flash-lite
